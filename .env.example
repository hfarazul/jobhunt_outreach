# Choose ONE backend: playwright or unipile
LINKEDIN_BACKEND=playwright

# --- Playwright backend ---
# After logging into LinkedIn once via `python -m linkedin_agent auth`,
# session state is stored at playwright_state/state.json. Nothing else needed.

# --- Unipile backend ---
# Sign up at unipile.com, connect your LinkedIn account, grab the API key + account ID.
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
UNIPILE_DSN=api.unipile.com:13xxx

# --- Safety / rate limits (per 24h rolling window) ---
DAILY_MAX_REACTIONS=30
DAILY_MAX_CONNECTIONS=20
DAILY_MAX_DMS=10
DAILY_MAX_SEARCHES=50

# Min/max delay between actions, seconds. Randomized within range.
ACTION_DELAY_MIN=30
ACTION_DELAY_MAX=90

# DRY_RUN=1 means tools log intent but never call LinkedIn.
DRY_RUN=0

# 24/7 mode — set to 1 to remove the 9-5 Mon-Fri send window. Default
# (0/unset) is windowed for lower LinkedIn detection risk; flip to 1 only
# if you've decided the always-on tradeoff is worth it.
LINKEDIN_DISABLE_SEND_WINDOW=0

# --- Drafting agent (only for UNATTENDED `daily`/`poll` runs) ---
# The autonomous drafter shells out to a coding-agent CLI you already have
# authenticated — NO LLM API key. When you drive an agent interactively, this
# is unused (you write the drafts). Leave unset to auto-detect the first of
# claude / codex / cursor-agent / gemini on PATH.
#   DRAFTER_AGENT=claude            # force a preset: claude | codex | cursor | gemini
#   DRAFTER_AGENT_CMD=my-agent -p   # or a custom command prefix; prompt appended as one arg

# --- Telegram (OPTIONAL — only for unattended phone-approval) ---
# Needed only if you run `daily`/`bot-run` unattended and want Approve/Edit/Reject
# cards on your phone. The whole interactive flow works without these. To enable:
# create a bot via @BotFather, then run `linkedin telegram-test` to find the chat id.
#   TELEGRAM_BOT_TOKEN=
#   TELEGRAM_CHAT_ID=
